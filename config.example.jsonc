{
  // 当前工作区使用的默认模型。Provider 和模型必须已经在
  // ~/.ainovel/models.json 公共模型库中配置。
  "provider": "openrouter",
  "model": "google/gemini-2.5-flash",

  // 工作区默认推理强度：off / low / medium / high / xhigh / max。
  // 省略时使用模型库中该模型的默认值。
  "reasoning_effort": "medium",

  // 可选。为特定角色选择独立模型；没有列出的角色跟随默认模型。
  // 角色配置必须同时包含 provider 和 model。
  "roles": {
    "architect": {
      "provider": "openrouter",
      "model": "google/gemini-3.1-pro",
      "reasoning_effort": "high"
    },
    "writer": {
      "provider": "ollama",
      "model": "qwen3:14b",
      "reasoning_effort": "off"
    }
  },

  "style": "default",

  // 可选的单工作区成本预算。
  "budget": {
    "book_usd": 50,
    "warn_ratio": 0.8,
    "hard_stop": false
  }
}
